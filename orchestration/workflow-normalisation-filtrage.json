      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const event = item.json?.body ?? item.json;\n  const record = event?.record;\n\n  if (!record || typeof record !== 'object') {\n    throw new Error('Payload webhook invalide : objet record manquant.');\n  }\n\n  const titre = typeof record.titre === 'string' ? record.titre : '';\n  const description = typeof record.description === 'string' ? record.description : '';\n  const priorite = typeof record.priorite === 'string' ? record.priorite : '';\n  const titreNormalise = titre.toLocaleLowerCase('fr-FR');\n  const motsUrgents = ['panne', 'bloquant', 'urgent'];\n\n  return {\n    json: {\n      idempotency_key: [event.table ?? 'tickets', record.id, event.type ?? 'INSERT', record.statut ?? 'nouveau'].join(':'),\n      ticket_id: record.id,\n      titre,\n      description,\n      priorite,\n      organisation_id: record.organisation_id,\n      alerte_immediate:\n        priorite.toLocaleLowerCase('fr-FR') === 'critique' ||\n        motsUrgents.some((mot) => titreNormalise.includes(mot)),\n    },\n  };\n});"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ],
        "id": "1508fe41-56d0-4722-b342-73f7007dacc2",
