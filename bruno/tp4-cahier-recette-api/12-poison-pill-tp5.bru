meta {
  name: 12 - Poison pill TP5
  type: http
  seq: 12
}

post {
  url: {{webhookUrl}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  webhookUrl: https://winston-length-univ-frank.trycloudflare.com/webhook/tickets-webhook
}

body:json {
  {
    "type": "INSERT",
    "table": "tickets",
    "schema": "public",
    "record": {
      "id": "ticket-invalide-123",
      "organisation_id": "b56e0fd9-ed3b-4c87-8a78-eadd9d39268b",
      "cree_par": "a0b6bfaa-70c5-4ac0-9801-7d18e1151d82",
      "titre": "Recette TP5 - poison pill",
      "description": "Ticket dedie au test de deduplication sequentielle.",
      "statut": "nouveau",
      "priorite": "critique",
      "metadata": {
        "source": "recette-tp5-poison"
      },
      "created_at": "2026-11-26T10:55:29.564611+00:00"
    },
    "old_record": null
  }
}

tests {
  test("Le webhook accuse reception HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Workflow was started");
  });
}

docs {
  Test volontairement en echec dans n8n. Le PATCH doit rejeter l'UUID invalide
  avec HTTP 400 apres trois tentatives espacees de 2000 ms, puis OPS doit
  enregistrer une ligne error_logs et envoyer une alerte Discord.
  Aucun ticket reel ne doit etre cree ni modifie par cette requete.
  Le HTTP 200 initial ne signifie pas que le workflow a reussi.
  Executer separement de la rafale 11.
}
